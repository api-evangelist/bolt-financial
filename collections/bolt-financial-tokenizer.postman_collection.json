  "info": {
    "_postman_id": "47830d73-4e0d-4246-95da-17b17bacd2a4",
    "name": "Tokenizer Endpoint",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "## About\nThe Tokenizer API provides an alternative to our [public npm package](https://www.npmjs.com/package/@boltpay/tokenizer). If you would prefer to use that, you can follow our [Tokenizer documentation](/developers/references/bolt-tokenizer). \n\n## How It Works\nThis API uses two endpoints to implement custom back-office integrations such as direct payment processing.\n\nThe `/public_key` endpoint returns a key used in the `/token` endpoint, used to encrypt and decrypt the payload containing credit card information.\n",
      "type": "text/plain"
    }
  }
